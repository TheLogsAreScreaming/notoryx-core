  "privacy_title": "Privacy",
  "privacy_toolSubtitle": "What the mesh, this phone and the internet can see",
  "privacy_meshHeading": "On the mesh",
  "privacy_dmTitle": "Direct messages",
  "privacy_dmBody": "Encrypted between your radio and theirs. Repeaters pass them on but can't read them. Short sender and recipient IDs and the route travel in the clear.",
  "privacy_channelTitle": "Channels",
  "privacy_channelBody": "Encrypted with the channel's key: anyone who has the key can read every message. Public and hashtag channel keys are known to everyone, so treat those channels as public.",
  "privacy_advertTitle": "Adverts and positions",
  "privacy_advertBody": "Your radio's name and public key, and its position if you share it, are broadcast unencrypted to everyone in range.",
  "privacy_phoneHeading": "On this phone",
  "privacy_phoneBody": "Messages, contacts, routes, track logs, waypoints, battery history and settings stay in the app's private storage, protected only by the phone's own security. Anything you export can be read by whoever has the file.",
  "privacy_netHeading": "Over the internet",
  "privacy_netIntro": "Only when you use the feature that needs it. Each request shows the service your IP address and what was asked for.",
  "privacy_netMaps": "Maps: tiles from OpenStreetMap, or Stadia Maps if you choose it, for the area you view.",
  "privacy_netTerrain": "Terrain: elevation from Open-Meteo for coverage and line of sight.",
  "privacy_netModels": "Downloads: translation and picture models from Hugging Face.",
  "privacy_netImages": "Pictures: GIF search from Giphy, and images from pyx.li links in messages.",
  "privacy_netLists": "Lists: regional presets and the channel directory from this app's GitHub releases repository.",
  "privacy_netMqtt": "MQTT: only the brokers you add. If you turn uploading on, packets your radio hears are published there. Broker passwords are kept in the phone's secure storage.",
  "privacy_netAnalyzer": "Analyzer: CoreScope lookups (who heard a packet, repeater names) when you use them.",
  "privacy_notHeading": "What NOTORYX doesn't do",
  "privacy_notBody": "No account, no analytics, no ads and no crash reports. The developers receive nothing unless you send it yourself.",
  "team_title": "Team tracking",
  "team_hint": "Shares your position to a private channel while this trip is active, so teammates see you move on their map. Turns off when the trip ends, or after 12 hours.",
